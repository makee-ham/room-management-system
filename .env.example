# Public browser configuration only. Copy this file to .env.local.
# Never add service-role keys, secret keys, passwords, or user tokens here.

# Runtime mode: "live" requires every value below; "demo" is only for deliberate local QA.
# Missing or invalid live configuration fails closed instead of opening demo data.
RMS_RUNTIME_MODE=live

# Supabase Edge Function API root, ending in /functions/v1/api.
RMS_API_BASE_URL=

# Supabase project URL for the same project as RMS_API_BASE_URL.
SUPABASE_URL=

# Browser-safe Supabase opaque publishable key (or legacy anon JWT) for the same project.
SUPABASE_PUBLISHABLE_KEY=

# Browser session storage policy: use "local" only on a dedicated trusted origin.
# Shared hosting such as makee-ham.github.io must use "session" until a custom domain is connected.
RMS_SESSION_PERSISTENCE=local

# Enabled after backend deployment and upload UAT. Set false before an older API rollback.
RMS_PHOTO_UPLOAD_SNAPSHOT=true

# Backend v0.9.5+ deployed contract verified on 2026-10-22. Disable for older API rollback.
RMS_ASSIGNMENT_PLANNING_DATE=true
RMS_ROOM_PIN_EXPORT=true

# Drive authentication is deployed; import remains blocked pending secret-free physical PIN confirmation.
RMS_ROOM_PIN_TRANSFER=false

# Backend v0.9.9/API53 supports required memo with optional 0-10 photos.
# Set false before rolling back to a backend that requires photos.
RMS_SUPPLEMENTAL_MEMO_ONLY=true
