    "/v1/room-types/{roomTypeId}/cleaning-fee": {
      "put": {
        "tags": [
          "Rooms"
        ],
        "operationId": "setRoomTypeCleaningFee",
        "summary": "객실 타입별 기본 청소 단가 변경",
        "description": "#577 개발 후보. 변경 후 카탈로그 단가로 생성하는 일반 청소에만 적용. 이미 생성된 미래 청소·진행 청소·확정 수당·재청소 승계금액은 변경하지 않습니다. 금액은 정수 원화이며 폭탄방 동액 보너스 합계의 DB integer 범위를 보호합니다. 현재 타입 version과 적용범위 확인이 필요합니다. 성공·재전송 뒤 GET /v1/room-types를 다시 조회하세요.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-roles": [
          "admin"
        ],
        "parameters": [
          {
            "name": "roomTypeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            },
            "description": "사용자 동작 한 번마다 생성합니다. 네트워크 오류로 **같은 요청 본문을 재시도할 때만 같은 값**을 재사용하고, 다른 본문에는 새 값을 사용합니다. `crypto.randomUUID()`를 권장합니다."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "baseCleaningFee",
                  "expectedVersion",
                  "confirmFutureTargetsOnly"
                ],
                "properties": {
                  "baseCleaningFee": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1073741823
                  },
                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740990
                  },
                  "confirmFutureTargetsOnly": {
                    "type": "boolean",
                    "const": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "확정 결과 또는 동일 요청의 기존 receipt. 현재 목록을 다시 조회합니다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "roomType"
                  ],
                  "properties": {
                    "roomType": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "roomTypeId",
                        "baseCleaningFee",
                        "version",
                        "effectiveFor"
                      ],
                      "properties": {
                        "roomTypeId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "baseCleaningFee": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1073741823
                        },
                        "version": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "effectiveFor": {
                          "type": "string",
                          "const": "NEW_TARGETS_ONLY"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "안정적인 `error.code`로 분기합니다. 화면 문구는 `message`를 그대로 계약으로 고정하지 말고 프론트에서 code 기준으로 관리합니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "안정적인 `error.code`로 분기합니다. 화면 문구는 `message`를 그대로 계약으로 고정하지 말고 프론트에서 code 기준으로 관리합니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "안정적인 `error.code`로 분기합니다. 화면 문구는 `message`를 그대로 계약으로 고정하지 말고 프론트에서 code 기준으로 관리합니다.",
            "content": {
